# Windows folder metadata
desktop.ini

# Raw BV-BRC AMR phenotype downloads (~450 MB + ~380 MB), read by
# run_patric_validation.py from the repo root. Too large for git (GitHub's hard
# limit is 100 MB per file); re-download from BV-BRC (bv-brc.org) if needed.
ecoli_amr.csv
klebsiella_amr.csv

# Run logs are not tracked. One exception: the training log cited as the source for
# claim U1 (the retired 0.9934) in paper/claims_to_numbers.md. A negation cannot escape an
# ignored DIRECTORY, so this ignores the contents rather than the directory itself.
logs/*
!logs/gnn_training_20260607_013207.log

# Personal Claude Code permission overrides (not project config)
.claude/settings.local.json

# In-progress scratch files written by long-running sweeps
ai/checkpoints/sweep/**/_tmp*
ai/checkpoints/reseeded/**/_tmp*
